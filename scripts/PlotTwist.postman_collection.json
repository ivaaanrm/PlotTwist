              "raw": "{\n  \"name\": \"Updated Collection Name\",\n  \"description\": \"Updated description\",\n  \"is_collaborative\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/named/{{named_collection_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "named", "{{named_collection_id}}"]
            },
            "description": "Update name, description, or collaborative status of a named collection."
          }
        },
        {
          "name": "Delete Named Collection",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/named/{{named_collection_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "named", "{{named_collection_id}}"]
            },
