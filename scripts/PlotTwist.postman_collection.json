        {
          "name": "List Named Collections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/named?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "named"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "List the current user's named collections."
          }
        },
        {
          "name": "Get Named Collection (with items)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/named/{{named_collection_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "named", "{{named_collection_id}}"]
            },
            "description": "Get a named collection's details including all its items."
          }
        },
        {
          "name": "Update Named Collection",
          "request": {
            "method": "PATCH",
