{
  "info": {
    "name": "PlotTwist API",
    "description": "Full API collection for the PlotTwist social movie app backend.\n\n## Setup\n1. Set `base_url` variable to your backend URL (default: `http://localhost:8000`)\n2. Run **Auth → Login** to auto-populate `auth_token`\n3. All protected endpoints use Bearer auth automatically via the collection-level auth setting\n\n## Variables\n- `base_url` — backend root URL\n- `auth_token` — JWT access token (auto-set on login)\n- `user_id`, `other_user_id` — UUIDs for user-related tests\n- `collection_id`, `collection_item_id` — UUIDs for collection tests\n- `follow_id`, `invitation_id` — UUIDs for follow/invitation tests\n- `tmdb_id` — TMDB movie/series ID for media tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "other_user_id", "value": "", "type": "string" },
    { "key": "collection_id", "value": "", "type": "string" },
    { "key": "collection_item_id", "value": "", "type": "string" },
    { "key": "named_collection_id", "value": "", "type": "string" },
    { "key": "named_collection_item_id", "value": "", "type": "string" },
    { "key": "follow_id", "value": "", "type": "string" },
    { "key": "invitation_id", "value": "", "type": "string" },
    { "key": "tmdb_id", "value": "550", "type": "string" },
    { "key": "superuser_token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{auth_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', json.access_token);",
                  "    console.log('Token saved:', json.access_token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "user@example.com", "description": "User email" },
                { "key": "password", "value": "changethis", "description": "User password" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/login/access-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "login", "access-token"]
            },
            "description": "OAuth2 password flow. Saves access_token to collection variable `auth_token`."
          }
        },
        {
          "name": "Login as Superuser",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('superuser_token', json.access_token);",
                  "    console.log('Superuser token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin@example.com", "description": "Superuser email" },
                { "key": "password", "value": "changethis", "description": "Superuser password" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/login/access-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "login", "access-token"]
            },
            "description": "Login as superuser. Saves token to `superuser_token`."
          }
        },
        {
          "name": "Test Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/login/test-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "login", "test-token"]
            },
            "description": "Returns the current user's data if the token is valid."
          }
        },
        {
          "name": "Request Password Recovery",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/password-recovery/user@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "password-recovery", "user@example.com"]
            },
            "description": "Sends a password reset email. Always returns success to prevent user enumeration."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_RESET_TOKEN_HERE\",\n  \"new_password\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reset-password/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reset-password", ""]
            },
            "description": "Reset password using token from email. Password must be 8-128 chars."
          }
        },
        {
          "name": "Get Password Recovery HTML (Superuser)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{superuser_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/password-recovery-html-content/user@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "password-recovery-html-content", "user@example.com"]
            },
            "description": "Returns the HTML content of the password recovery email. Superuser only."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register (public signup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', json.id);",
                  "    console.log('New user ID:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"New User\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "signup"]
            },
            "description": "Public user registration. No auth required. Password must be 8-128 chars."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('user_id', json.id);",
                  "    console.log('Current user ID:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the currently authenticated user's profile."
          }
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"email\": \"updated@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Update current user's full_name and/or email."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"changethis\",\n  \"new_password\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "password"]
            },
            "description": "Change the current user's password. Requires current password."
          }
        },
        {
          "name": "Delete Current User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Permanently delete current user's account. Superusers cannot delete themselves."
          }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/search?query=john&skip=0&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [
                { "key": "query", "value": "john", "description": "Search by name or email" },
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Search users by name or email. Returns paginated results."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{other_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{other_user_id}}"]
            },
            "description": "Get any user's public info by UUID."
          }
        },
        {
          "name": "Get User Profile (with collections)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{other_user_id}}/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{other_user_id}}", "profile"]
            },
            "description": "Get a user's full profile including watched count, average rating, watched media, and watchlist."
          }
        },
        {
          "name": "[Admin] List All Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{superuser_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/?skip=0&limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", ""],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "List all users (paginated). Superuser only."
          }
        },
        {
          "name": "[Admin] Create User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{superuser_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"adminmade@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Admin Created User\",\n  \"is_active\": true,\n  \"is_superuser\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", ""]
            },
            "description": "Create a new user as admin. Superuser only."
          }
        },
        {
          "name": "[Admin] Update User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{superuser_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Renamed by Admin\",\n  \"is_active\": true,\n  \"is_superuser\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{other_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{other_user_id}}"]
            },
            "description": "Update any user's data. Superuser only."
          }
        },
        {
          "name": "[Admin] Delete User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{superuser_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{other_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{other_user_id}}"]
            },
            "description": "Delete any user by ID. Superuser only."
          }
        }
      ]
    },
    {
      "name": "Collections (Personal)",
      "description": "Personal unnamed collections such as 'watched', 'watchlist', 'favorites'. Use the collection_name path param to target any named bucket.",
      "item": [
        {
          "name": "Add to Watched",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('collection_item_id', json.id);",
                  "    console.log('Collection item ID:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tmdb_id\": 550,\n  \"media_type\": \"movie\",\n  \"rating\": 4.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/watched",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "watched"]
            },
            "description": "Add a movie/series to the 'watched' collection with an optional rating (0.5–5.0, 0.5 steps)."
          }
        },
        {
          "name": "Add to Watchlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tmdb_id\": 27205,\n  \"media_type\": \"movie\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/watchlist",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "watchlist"]
            },
            "description": "Add a movie/series to the 'watchlist' (no rating needed)."
          }
        },
        {
          "name": "Add to Favorites",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tmdb_id\": 238,\n  \"media_type\": \"movie\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/favorites",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "favorites"]
            },
            "description": "Add to 'favorites' personal collection."
          }
        },
        {
          "name": "List Watched",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/watched?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "watched"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "List all items in the current user's 'watched' collection."
          }
        },
        {
          "name": "List Watchlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/watchlist?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "watchlist"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "List all items in the current user's 'watchlist'."
          }
        },
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/collections/favorites?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "favorites"],
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "List all items in the current user's 'favorites' collection."
          }
        },
        {
          "name": "Update Collection Item (rating)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 3.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/items/{{collection_item_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "items", "{{collection_item_id}}"]
